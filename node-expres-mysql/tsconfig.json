{
  "compilerOptions": {
    "skipDefaultLibCheck": true,
    "outDir": "./dist",
    
    // 1. ปรับมาใช้ระบบจัดการโมดูลมาตรฐานทั่วไป
    "module": "Node16",
    "target": "ES2022",
    
    // 2. เปิดตัวช่วยจำลองแปลงโค้ดให้เขียน import แบบธรรมดาได้ (เส้นแดงจาก express/http จะหายไป)
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    
    // 3. ปิดโหมดตรวจเข้มงวดน่ารำคาญ (เปลี่ยนเป็น false)
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  }
}
